{
	"_version": "2.0.0",
	"sap.app": {
		"type": "card",
		"applicationVersion": {
			"version": "1.0.0"
		}
	},
	"sap.card": {
		"type": "List",
		"header": {
			"data": {
				"request": {
					"url": "sap/ui/integration/sample/LazyLoading/manifests/listData2.json"
				},
				"path": "/header"
			},
			"title": "Error Test Case ",
			"subtitle": "Unable to fetch data",
			"icon": {
				"src": "{src}"
			}
		},
		"content": {
			"data": {
				"request": {
					"url": "sap/ui/integration/sample/LazyLoading/manifests/listData2.json"
				},
				"path": "/content"
			},
			"item": {
				"title": {
					"label": "Title",
					"value": "{Name}"
				},
				"icon": {
					"src": "{icon}"
				},
				"description": {
					"value": "{Name}"
				}
			}
		}
	}
}