<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">


	<!--**************************************************************************
	* POM SECTION: Maven Model Version Settings
	***************************************************************************-->

	<modelVersion>4.0.0</modelVersion>


	<!--**************************************************************************
	* POM SECTION: Parent POM Settings
	***************************************************************************-->

	<parent>
		<groupId>com.sap.openui5</groupId>
		<artifactId>reactor</artifactId>
		<version>1.156.0-SNAPSHOT</version><!--TargetVersion-->
		<relativePath>../../pom.xml</relativePath>
	</parent>


	<!--**************************************************************************
	* POM SECTION: Maven Settings
	***************************************************************************-->

	<artifactId>sap.f</artifactId>
	<packaging>jar</packaging>


	<!--**************************************************************************
	* POM SECTION: Project Settings
	***************************************************************************-->

	<name>${project.artifactId}</name>
	<description>OpenUI5 UI Library: ${project.artifactId}</description>


	<!--**************************************************************************
	* POM SECTION: Properties Settings
	***************************************************************************-->

	<properties>

		<!-- source paths for Sonar reporting -->
		<sonar.sources>src,pom.xml</sonar.sources>

		<!-- enable eslint validation -->
		<sap.ui5.eslint.skip.validation>false</sap.ui5.eslint.skip.validation>

		<!-- enable stylelint validation -->
		<sap.ui5.stylelint.skip.validation>false</sap.ui5.stylelint.skip.validation>

		<!-- enable the packaging of the NPM resources -->
		<npm.package.phase>package</npm.package.phase>

	</properties>


	<!--**************************************************************************
	* POM SECTION: Build Settings
	***************************************************************************-->

	<build>

		<resources>
			<resource>
				<directory>src</directory>
				<targetPath>META-INF/resources</targetPath>
				<filtering>true</filtering>
			</resource>
			<resource>
				<directory>test</directory>
				<targetPath>META-INF/test-resources</targetPath>
			</resource>
		</resources>

	</build>


	<!--**************************************************************************
	* POM SECTION: Profile Settings
	***************************************************************************-->

	<profiles>

		<!-- Verification of the @ui5/webcomponents versions are in sync -->
		<profile>
			<id>webcomponents.verify</id>
			<build>
				<plugins>
					<plugin>
						<groupId>com.sap.ui5.tools.maven</groupId>
						<artifactId>node-maven-plugin</artifactId>
						<version>2.0.16</version><!--DependencyVersion,manualChange-->
						<configuration>
							<nodeType>SHARED</nodeType>
							<nodeVersion>${node.version}</nodeVersion>
							<nodeLocation>${node.location}</nodeLocation>
							<npmRegistry>${npm.registry}</npmRegistry>
							<npmVersion>${npm.version}</npmVersion>
							<forceNoProxy>${node.forceNoProxy}</forceNoProxy>
						</configuration>
						<executions>
							<!-- Ensure Node.js and npm are installed before running the verify script -->
							<execution>
								<id>install-node-and-npm</id>
								<phase>initialize</phase>
								<goals>
									<goal>install</goal>
								</goals>
							</execution>
							<execution>
								<id>verify-webcomponents-version</id>
								<phase>verify</phase>
								<goals>
									<goal>npm</goal>
								</goals>
								<configuration>
									<workDir>${project.basedir}</workDir>
									<args>
										<arg>run</arg>
										<arg>verify-webcomponents</arg>
									</args>
									<!-- default allowedExitCodes=0: script exit 1 on drift fails the build -->
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>

	</profiles>


</project>
