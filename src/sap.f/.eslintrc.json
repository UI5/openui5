{
	"overrides": [
		/*
		 * Productive code and test code of sap.f has been cleaned up.
		 * No more references to the global jQuery allowed
		 */
		{
			"files": [
				"src/**/*.js",
				"test/**/*.js"
			],
			"globals": {
				"jQuery": "off"
			}
		},

		/*
		 * Build / maintenance scripts under scripts/ are CommonJS Node.js modules.
		 * Allow require, __dirname, process, etc. and module-global "use strict".
		 */
		{
			"files": [
				"scripts/**/*.js"
			],
			"env": {
				"browser": false,
				"node": true
			},
			"parserOptions": {
				"sourceType": "commonjs"
			},
			"rules": {
				"no-console": "off",
				"strict": ["error", "global"]
			}
		}
	]
}
