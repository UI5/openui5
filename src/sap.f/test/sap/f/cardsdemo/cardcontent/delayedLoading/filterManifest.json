{
	"_version": "2.0.0",
	"sap.app": {
		"id": "cardsdemo.samples.list1",
		"type": "card",
		"title": "Card 'cardsdemo.samples.list1'",
		"applicationVersion": {
			"version": "1.0.0"
		}
	},
	"sap.card": {
		"type": "List",
		"configuration": {
			"filters": {
				"listFilter": {
					"value": "1",
					"item": {
						"path": "/filter/items",
						"template": {
							"key": "{key}",
							"title": "{title}"
						}
					},
					"data": {
						"request": {
							"url": "./listData1.json"
						}
					}
				}
			}
		},
		"header": {
			"data": {
				"request": {
					"url": "./listData1.json"
				},
				"path": "/header"
			},
			"title": "{title}",
			"subtitle": "{subtitle}",
			"icon": {
				"src": "sap-icon://list"
			}
		},
		"content": {
			"maxItems": 3,
			"data": {
				"request": {
					"url": "./listData1.json"
				},
				"path": "/content"
			},
			"item": {
				"title": {
					"label": "Title",
					"value": "{Name}"
				},
				"icon": {
					"src": "{icon}"
				},
				"highlight": "{state}",
				"info": {
					"value": "{info}",
					"state": "{infoState}"
				}
			}
		}
	}
}