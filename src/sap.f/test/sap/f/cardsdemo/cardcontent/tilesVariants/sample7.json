{
	"_version": "2.0.0",
	"sap.app": {
		"id": "cardsdemo.tilesVariants.sample7",
		"type": "card",
		"title": "Card 'sample7'",
		"applicationVersion": {
			"version": "1.0.0"
		}
	},
	"sap.card": {
		"type": "List",
		"header": {
			"data": {
				"request": {
					"url": "./data7.json"
				}
			},
			"title": "{title}",
			"subtitle": "{subtitle}",
			"wrappingType": "Hyphenated",
			"actions": [
				{
					"type": "Navigation",
					"parameters": {
						"url": "http://sap.com"
					}
				}
			]
		},
		"content": {
			"data": {
				"json": [
					{
						"Name": "Comfort Easy"
					}
				]
			},
			"item": {
				"title": "{Name}"
			}
		}
	}
}