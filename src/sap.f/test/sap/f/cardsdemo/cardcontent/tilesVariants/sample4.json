{
	"_version": "2.0.0",
	"sap.app": {
		"id": "cardsdemo.tilesVariants.sample4",
		"type": "card",
		"title": "Card 'sample4'",
		"applicationVersion": {
			"version": "1.0.0"
		}
	},
	"sap.card": {
		"type": "List",
		"header": {
			"data": {
				"request": {
					"url": "./data4.json"
				}
			},
			"title": "{title}",
			"subtitle": "{subtitle}",
			"icon": {
				"src": "{icon/src}",
				"shape": "{icon/shape}"
			}
		},
		"content": {
			"data": {
				"json": [
					{
						"Name": "Comfort Easy"
					}
				]
			},
			"item": {
				"title": "{Name}"
			}
		}
	}
}