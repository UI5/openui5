{
	"_version": "1.14.0",
	"sap.app": {
		"id": "card.test.badge.manifestBinding",
		"type": "card"
	},
	"sap.card": {
		"type": "List",
		"data": {
			"json": {
				"badgeInfo": [
					{
						"text": "New",
						"icon": "sap-icon://status-in-process",
						"state": "Indication03"
					},
					{
						"text": "Pending Approval",
						"icon": "sap-icon://pending",
						"state": "Warning"
					}
				]
			},
			"path": "/"
		},
		"badges": [
			{
				"text": "{badgeInfo/0/text}",
				"icon": "{badgeInfo/0/icon}",
				"state": "{badgeInfo/0/state}"
			},
			{
				"text": "{badgeInfo/1/text}",
				"icon": "{badgeInfo/1/icon}",
				"state": "{badgeInfo/1/state}"
			}
		],
		"header": {
			"title": "Badges with Bindings",
			"subTitle": "Badge data from card model"
		},
		"content": {
			"data": {
				"json": [
					{
						"Name": "Caroline Clark"
					},
					{
						"Relation": "Dependent",
						"Status": "New - Pending Approval"
					},
					{
						"Name": "John Clark",
						"Relation": "Husband",
						"Status": "Approved"
					},
					{
						"Name": "Sarah Clark",
						"Relation": "Mother",
						"Status": "Updated"
					}
				]
			},
			"item": {
				"title": "{Name}",
				"description": "{Relation}",
				"info": {
					"value": "{Status}"
				}
			}
		}
	}
}
