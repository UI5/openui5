{
	"_version": "2.0.0",
	"sap.app": {
		"id": "cardsdemo.navigationService.card2",
		"type": "card",
		"title": "Card 'cardsdemo.navigationService.card2'",
		"applicationVersion": {
			"version": "1.0.0"
		}
	},
	"sap.ui5": {
		"services": {
			"Navigation2": {
				"factoryName": "cardsdemo.service.SampleNavigationFactory"
			}
		}
	},
	"sap.card": {
		"type": "List",
		"header": {
			"title": "Request List Content Card 2",
			"subtitle": "Card Subtitle",
			"icon": {
				"src": "sap-icon://accept"
			},
			"status": "100 of 200",
			"actions": [
				{
					"type": "Navigation",
					"url": "https://www.sap.com"
				}
			]
		},
		"content": {
			"data": {
				"request": {
					"url": "../someitems_services.json"
				}
			},
			"item": {
				"icon": {
					"src": "{icon}"
				},
				"title": {
					"value": "{Name}"
				},
				"description": {
					"value": "{Description}"
				},
				"actions": [
					{
						"type": "Navigation",
						"service": "Navigation2",
						"parameters": {
							"url": "{url}"
						}
					}
				]
			}
		}
	}
}