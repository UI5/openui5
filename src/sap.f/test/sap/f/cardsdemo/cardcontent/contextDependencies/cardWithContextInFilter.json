{
	"sap.app": {
		"id": "sap.f.cardsdemo.cardcontent.contextDependencies.cardWithContextInFilter",
		"type": "card"
	},
	"sap.card": {
		"type": "List",
		"configuration": {
			"parameters": {
				"userId": {
					"value": "{context>/sample/currentUser/id}"
				}
			},
			"filters": {
				"category": {
					"type": "Select",
					"label": "Category",
					"value": "{context>/sample/currentUser/id}",
					"data": {
						"request": {
							"url": "./categories.json"
						}
					},
					"item": {
						"template": {
							"key": "{key}",
							"title": "{title}"
						}
					}
				}
			}
		},
		"header": {
			"title": "Filtered tasks",
			"subtitle": "User ID: {parameters>/userId/value}",
			"icon": {
				"src": "sap-icon://filter"
			}
		},
		"content": {
			"data": {
				"json": [
					{"title": "Approve purchase order", "description": "PO #12345"},
					{"title": "Review budget report", "description": "Q2 2026"}
				]
			},
			"item": {
				"title": "{title}",
				"description": "{description}"
			}
		}
	}
}
