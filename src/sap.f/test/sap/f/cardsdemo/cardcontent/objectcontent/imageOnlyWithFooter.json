{
	"_version": "2.0.0",
	"sap.app": {
		"id": "cardsdemo.object.imageOnlyWithFooter",
		"type": "card",
		"title": "Card 'imageOnlyWithFooter'",
		"applicationVersion": {
			"version": "1.0.0"
		}
	},
	"sap.card": {
		"type": "Object",
		"content": {
			"groups": [
				{
					"alignment": "Stretch",
					"items": [
						{
							"type": "Image",
							"src": "../../images/grass.jpg",
							"fullWidth": true
						}
					]
				}
			]
		},
		"footer": {
			"actionsStrip": [
				{
					"text": "Send Reminder",
					"buttonType": "Accept"
				}
			]
		}
	}
}