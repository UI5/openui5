{
	"_version": "2.0.0",
	"sap.app": {
		"id": "cardsdemo.object.imageOnly",
		"type": "card",
		"title": "Card 'imageOnly'",
		"applicationVersion": {
			"version": "1.0.0"
		}
	},
	"sap.card": {
		"type": "Object",
		"actions": [
			{
				"type": "Navigation",
				"parameters": {
					"url": "https://www.sap.com"
				}
			}
		],
		"header": {
			"icon": {
				"src": "sap-icon://business-objects-experience"
			},
			"title": "Object Card",
			"subtitle": "With Image Only and Action on the Content"
		},
		"content": {
			"groups": [
				{
					"alignment": "Stretch",
					"items": [
						{
							"type": "Image",
							"src": "../../images/grass.jpg",
							"fullWidth": true
						}
					]
				}
			]
		}
	}
}