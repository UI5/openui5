{
	"_version": "2.0.0",
	"sap.app": {
		"id": "card.bundle.list",
		"type": "card",
		"i18n": "i18n/i18n.properties",
		"title": "Card 'card.bundle.list'",
		"applicationVersion": {
			"version": "1.0.0"
		}
	},
	"sap.card": {
		"type": "List",
		"header": {
			"title": "{{title}}",
			"subtitle": "{{subtitle}}"
		},
		"data": {
			"request": {
				"url": "./mockdata/employees.json"
			}
		},
		"content": {
			"item": {
				"title": "{Title}",
				"description": "{Position}",
				"icon": {
					"src": "{Icon}"
				},
				"actions": [
					{
						"type": "Navigation",
						"enabled": "{= ${Url}}",
						"parameters": {
							"url": "{Url}"
						}
					}
				]
			}
		}
	}
}