{
	"_version": "2.0.0",
	"sap.app": {
		"type": "card",
		"id": "cardWithExtension",
		"dataSources": {
			"products": {
				"uri": "https://services.odata.org/V3/Northwind/Northwind.svc",
				"type": "OData"
			}
		},
		"title": "Card 'cardWithExtension'",
		"applicationVersion": {
			"version": "1.0.0"
		}
	},
	"sap.card": {
		"extension": "./ListCardSampleExtensionInvalidRequest",
		"configuration": {
			"parameters": {
				"city": {
					"value": "Sofia"
				}
			}
		},
		"data": {
			"extension": {
				"method": "getData",
				"args": [
					"{parameters>/city/value}",
					"arg2",
					"arg3",
					"arg4"
				]
			}
		},
		"type": "List",
		"header": {
			"title": "Invalid card.request",
			"subtitle": "City {parameters>/city/value}"
		},
		"content": {
			"item": {
				"title": "{city}",
				"description": "{description}",
				"actions": [
					{
						"type": "Navigation",
						"parameters": {
							"city": "{city}"
						}
					}
				]
			}
		}
	}
}