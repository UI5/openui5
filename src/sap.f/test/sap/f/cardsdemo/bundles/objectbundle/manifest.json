{
	"_version": "2.0.0",
	"sap.app": {
		"id": "card.bundle.object",
		"type": "card",
		"i18n": "i18n/i18n.properties",
		"title": "Card 'object'",
		"applicationVersion": {
			"version": "1.0.0"
		}
	},
	"sap.card": {
		"type": "Object",
		"data": {
			"request": {
				"url": "./mockdata/employee.json"
			},
			"json": {
				"activityStatus": [
					{
						"key": "active",
						"text": "Active"
					},
					{
						"key": "inactive",
						"text": "Inactive"
					},
					{
						"key": "vacation",
						"text": "On Vacation"
					},
					{
						"key": "sick",
						"text": "Sick Leave",
						"enabled": false
					}
				]
			}
		},
		"header": {
			"icon": {
				"src": "{photo}"
			},
			"title": "{firstName} {lastName}",
			"subtitle": "{position}"
		},
		"content": {
			"groups": [
				{
					"title": "{{contactDetails}}",
					"items": [
						{
							"label": "{{firstName}}",
							"value": "{firstName}"
						},
						{
							"label": "{{lastName}}",
							"value": "{lastName}"
						},
						{
							"label": "{{phone}}",
							"value": "{phone}",
							"actions": [
								{
									"type": "Navigation",
									"parameters": {
										"url": "tel:{phone}"
									}
								}
							]
						},
						{
							"label": "Email",
							"valueEntries": [
								{
									"value": "{email}",
									"tooltip": "Send work email",
									"actions": [
										{
											"type": "Navigation",
											"parameters": {
												"url": "mailto:{email}"
											}
										}
									]
								},
								{
									"value": "{privateEmail}",
									"tooltip": "Send personal email",
									"actions": [
										{
											"type": "Navigation",
											"parameters": {
												"url": "mailto:{privateEmail}"
											}
										}
									]
								}
							]
						},
						{
							"label": "Team",
							"type": "IconGroup",
							"path": "team",
							"template": {
								"icon": {
									"src": "{imageUrl}",
									"initials": "{= format.initials(${firstName} + ' ' + ${lastName}) }"
								},
								"actions": [
									{
										"type": "Navigation",
										"parameters": {
											"url": "{imageUrl}"
										}
									}
								]
							}
						},
						{
							"label": "Attachments",
							"type": "ButtonGroup",
							"path": "attachments",
							"template": {
								"icon": "{icon}",
								"text": "{title}",
								"actions": [
									{
										"type": "Navigation",
										"parameters": {
											"url": "{url}"
										}
									}
								]
							}
						}
					]
				},
				{
					"title": "{{organizationalDetails}}",
					"items": [
						{
							"label": "{{directManager}}",
							"value": "{manager/firstName} {manager/lastName}",
							"icon": {
								"src": "{manager/photo}"
							}
						}
					]
				},
				{
					"title": "{{companyDetails}}",
					"items": [
						{
							"label": "{{companyName}}",
							"value": "{company/name}"
						},
						{
							"label": "{{address}}",
							"value": "{company/address}"
						},
						{
							"label": "{{website}}",
							"value": "{company/website}",
							"actions": [
								{
									"type": "Navigation",
									"parameters": {
										"url": "{company/website}"
									}
								}
							]
						}
					]
				},
				{
					"items": [
						{
							"id": "status",
							"label": "Employee Status",
							"type": "RadioButtonGroup",
							"validations": [
								{
									"required": true
								}
							],
							"item": {
								"path": "/activityStatus",
								"template": {
									"key": "{key}",
									"title": "{text}",
									"enabled": "{enabled}"
								}
							}
						}
					]
				}
			]
		}
	}
}