{
	"sap.app": {
		"id": "sap.f.sample.FlexibleColumnLayoutWithOneColumnStart",
		"applicationVersion": {
			"version": "1.0.0"
		},
		"title": "Flexible Column Layout with Routing and One Initial Column",
		"description": "A routing-based app using FlexibleColumnLayout that starts in OneColumn layout, with FlexibleColumnLayoutSemanticHelper driving layout transitions, custom column-distribution layout data for desktop and tablet, navigation-arrow URL sync, and fullscreen toggling of the detail columns.",
		"tags": {
			"keywords": [
				"sap.f.FlexibleColumnLayout",
				"routing",
				"semantic-helper",
				"one-column",
				"layout-type",
				"fullscreen",
				"column-distribution"
			]
		},
		"complexity": "advanced"
	},
	"sap.ui5": {
		"config": {
			"sample": {
				"iframe": "webapp/index.html",
				"stretch": true,
				"files": [
					"webapp/view/Detail.view.xml",
					"webapp/view/DetailDetail.view.xml",
					"webapp/view/FlexibleColumnLayout.view.xml",
					"webapp/view/List.view.xml",
					"webapp/view/AboutPage.view.xml",
					"webapp/controller/Detail.controller.js",
					"webapp/controller/DetailDetail.controller.js",
					"webapp/controller/FlexibleColumnLayout.controller.js",
					"webapp/controller/List.controller.js",
					"webapp/controller/AboutPage.controller.js",
					"webapp/Component.js",
					"webapp/index.html",
					"webapp/index.js",
					"webapp/manifest.json",
					"ui5.yaml",
					"package.json"
				]
			}
		}
	}
}