<mvc:View
	controllerName="sap.f.sample.HeroBannerBasic.C"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:f="sap.f"
	height="100%"
	displayBlock="true">
	<Page showHeader="false">
		<content>
			<VBox class="sapUiMediumMarginBeginEnd sapUiMediumMarginTop">
				<f:HeroBanner
					headerText="Good Morning, Anna"
					overlineText="Monday, May 26, 2026" />
			</VBox>
		</content>
	</Page>
</mvc:View>
