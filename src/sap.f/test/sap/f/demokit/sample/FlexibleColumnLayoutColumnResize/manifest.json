{
	"sap.app": {
		"id": "sap.f.sample.FlexibleColumnLayoutColumnResize",
		"applicationVersion": {
			"version": "1.0.0"
		},
		"title": "Flexible Column Layout with programmatic scrolling to an item",
		"description": "A FlexibleColumnLayout app that listens to the columnResize event and, once the begin column is fully resized in OneColumn layout, selects a specific ObjectPageLayout section from a section index carried in the route, scrolling the newly navigated column to that item.",
		"tags": {
			"keywords": [
				"sap.f.FlexibleColumnLayout",
				"column-resize",
				"routing",
				"semantic-helper",
				"object-page-layout",
				"scrolling"
			]
		},
		"complexity": "intermediate"
	},
	"sap.ui5": {
		"config": {
			"sample": {
				"iframe": "webapp/index.html",
				"stretch": true,
				"files": [
					"webapp/view/Detail.view.xml",
					"webapp/view/FlexibleColumnLayout.view.xml",
					"webapp/view/List.view.xml",
					"webapp/controller/Detail.controller.js",
					"webapp/controller/FlexibleColumnLayout.controller.js",
					"webapp/controller/List.controller.js",
					"webapp/data/sections.json",
					"webapp/Component.js",
					"webapp/index.html",
					"webapp/index.js",
					"webapp/manifest.json",
					"ui5.yaml",
					"package.json"
				]
			}
		}
	}
}