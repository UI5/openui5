{
	"sap.app": {
		"id": "sap.f.sample.ProductSwitchNavigation",
		"applicationVersion": {
			"version": "1.0.0"
		},
		"title": "Product Switch with Navigation",
		"description": "A standalone ProductSwitch opened from a Button as a ResponsivePopover; the change event reads the selected ProductSwitchItem's targetSrc property and uses sap.m.URLHelper.redirect to navigate to the target URL.",
		"tags": {
			"keywords": [
				"sap.f.ProductSwitch",
				"sap.f.ProductSwitchItem",
				"navigation",
				"url-helper",
				"target-src",
				"responsive-popover"
			]
		},
		"complexity": "basic"
	},
	"sap.ui5": {
		"rootView": {
			"viewName": "sap.f.sample.ProductSwitchNavigation.view.ProductSwitchNavigation",
			"type": "XML",
			"async": true
		},
		"dependencies": {
			"libs": {
				"sap.f": {},
				"sap.m": {},
				"sap.ui.core": {},
				"sap.ui.layout": {}
			}
		},
		"config": {
			"sample": {
				"stretch": true,
				"files": [
					"view/ProductSwitchPopover.fragment.xml",
					"view/ProductSwitchNavigation.view.xml",
					"controller/ProductSwitchNavigation.controller.js",
					"model/data.json",
					"manifest.json"
				]
			}
		}
	}
}