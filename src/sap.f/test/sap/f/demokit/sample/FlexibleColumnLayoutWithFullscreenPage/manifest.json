{
	"sap.app": {
		"id": "sap.f.sample.FlexibleColumnLayoutWithFullscreenPage",
		"applicationVersion": {
			"version": "1.0.0"
		},
		"title": "Flexible Column Layout with Routing and first page in fullscreen only",
		"description": "A routing-based FlexibleColumnLayout app where the first detail page opens fullscreen in the begin column (both initial targets use beginColumnPages) before the mid and end columns appear, using FlexibleColumnLayoutSemanticHelper and navigation-arrow URL sync.",
		"tags": {
			"keywords": [
				"sap.f.FlexibleColumnLayout",
				"routing",
				"semantic-helper",
				"fullscreen",
				"one-column",
				"layout-type",
				"begin-column"
			]
		},
		"complexity": "advanced"
	},
	"sap.ui5": {
		"config": {
			"sample": {
				"iframe": "webapp/index.html",
				"stretch": true,
				"files": [
					"webapp/view/Detail.view.xml",
					"webapp/view/DetailDetail.view.xml",
					"webapp/view/FlexibleColumnLayout.view.xml",
					"webapp/view/List.view.xml",
					"webapp/view/DetailDetailDetail.view.xml",
					"webapp/controller/Detail.controller.js",
					"webapp/controller/DetailDetail.controller.js",
					"webapp/controller/FlexibleColumnLayout.controller.js",
					"webapp/controller/List.controller.js",
					"webapp/controller/DetailDetailDetail.controller.js",
					"webapp/Component.js",
					"webapp/index.html",
					"webapp/index.js",
					"webapp/manifest.json",
					"ui5.yaml",
					"package.json"
				]
			}
		}
	}
}