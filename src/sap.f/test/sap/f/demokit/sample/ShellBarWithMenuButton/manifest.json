			"keywords": [
				"sap.f.ShellBar",
				"menu-button",
				"nav-button",
				"show-menu-button",
				"show-nav-button"
			]
		},
		"complexity": "basic"
	},
	"sap.ui5": {
		"rootView": {
			"viewName": "sap.f.sample.ShellBarWithMenuButton.ShellBarWithMenuButton",
			"type": "XML",
			"async": true
		},
		"dependencies": {
			"libs": {
				"sap.f": {},
				"sap.m": {},
				"sap.ui.core": {},
				"sap.ui.layout": {}
			}
		},
		"config": {
			"sample": {
				"stretch": true,
				"files": [
					"ShellBarWithMenuButton.view.xml",
					"ShellBarWithMenuButton.controller.js",
					"manifest.json"
				]
			}
		}
	}
}