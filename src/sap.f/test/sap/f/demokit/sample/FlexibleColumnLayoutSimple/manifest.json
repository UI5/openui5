{
	"sap.app": {
		"id": "sap.f.sample.FlexibleColumnLayoutSimple",
		"applicationVersion": {
			"version": "1.0.0"
		},
		"title": "Flexible Column Layout (with Event Bus)",
		"description": "The minimal FlexibleColumnLayout pattern: clicking a link in one column uses the EventBus to lazy-load the next view and setLayout to reveal the next column (two- then three-column layouts).",
		"tags": {
			"keywords": [
				"sap.f.FlexibleColumnLayout",
				"event-bus",
				"set-layout",
				"lazy-loading",
				"column-navigation"
			]
		},
		"complexity": "basic"
	},
	"sap.ui5": {
		"rootView": {
			"viewName": "sap.f.sample.FlexibleColumnLayoutSimple.view.FlexibleColumnLayout",
			"type": "XML",
			"async": true
		},
		"dependencies": {
			"libs": {
				"sap.f": {},
				"sap.m": {},
				"sap.ui.core": {}
			}
		},
		"config": {
			"sample": {
				"stretch": true,
				"files": [
					"Component.js",
					"controller/FlexibleColumnLayout.controller.js",
					"view/FlexibleColumnLayout.view.xml",
					"controller/List.controller.js",
					"view/List.view.xml",
					"controller/Detail.controller.js",
					"controller/DetailDetail.controller.js",
					"view/Detail.view.xml",
					"view/DetailDetail.view.xml",
					"manifest.json"
				]
			}
		}
	}
}