{
	"_version": "1.15.0",
	"sap.app": {
		"id": "sap.f.sample.HeroBannerIntegrationCard.endContent",
		"type": "card"
	},
	"sap.card": {
		"type": "List",
		"header": {
			"title": "Upcoming Events",
			"subtitle": "Today",
			"status": {
				"text": "2 events"
			}
		},
		"content": {
			"data": {
				"json": [
					{
						"time": "14:00",
						"title": "Team Meeting",
						"location": "Conference Room B",
						"highlight": "Success"
					}
				]
			},
			"item": {
				"icon": {
					"src": "sap-icon://calendar"
				},
				"title": {
					"value": "{title}"
				},
				"description": {
					"value": "{time} · {location}"
				},
				"highlight": "{highlight}"
			}
		}
	}
}
