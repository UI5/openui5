{
	"sap.app": {
		"id": "sap.f.sample.FlexibleColumnLayoutWithTwoColumnStart",
		"applicationVersion": {
			"version": "1.0.0"
		},
		"title": "Flexible Column Layout with Routing and Two Initial Columns",
		"description": "A routing-based app using FlexibleColumnLayout that opens with two initial columns via FlexibleColumnLayoutSemanticHelper (initialColumnsCount 2), with navigation-arrow URL sync and an end-column fullscreen route.",
		"tags": {
			"keywords": [
				"sap.f.FlexibleColumnLayout",
				"routing",
				"semantic-helper",
				"two-column",
				"layout-type",
				"fullscreen"
			]
		},
		"complexity": "intermediate"
	},
	"sap.ui5": {
		"config": {
			"sample": {
				"iframe": "webapp/index.html",
				"stretch": true,
				"files": [
					"webapp/view/Detail.view.xml",
					"webapp/view/DetailDetail.view.xml",
					"webapp/view/FlexibleColumnLayout.view.xml",
					"webapp/view/List.view.xml",
					"webapp/view/AboutPage.view.xml",
					"webapp/controller/Detail.controller.js",
					"webapp/controller/DetailDetail.controller.js",
					"webapp/controller/FlexibleColumnLayout.controller.js",
					"webapp/controller/List.controller.js",
					"webapp/controller/AboutPage.controller.js",
					"webapp/Component.js",
					"webapp/index.html",
					"webapp/index.js",
					"webapp/manifest.json",
					"ui5.yaml",
					"package.json"
				]
			}
		}
	}
}