{
	"sap.app": {
		"id": "sap.f.sample.FlexibleColumnLayoutLandmarkInfo",
		"applicationVersion": {
			"version": "1.0.0"
		},
		"title": "Flexible Column Layout Landmark Info For Columns",
		"description": "A FlexibleColumnLayout using FlexibleColumnLayoutAccessibleLandmarkInfo to set custom accessibility landmark labels on the first and last columns, with EventBus-driven column navigation and setLayout transitions.",
		"tags": {
			"keywords": [
				"sap.f.FlexibleColumnLayout",
				"accessibility",
				"landmark-info",
				"column-labels",
				"event-bus",
				"set-layout"
			]
		},
		"complexity": "intermediate"
	},
	"sap.ui5": {
		"rootView": {
			"viewName": "sap.f.sample.FlexibleColumnLayoutLandmarkInfo.view.FlexibleColumnLayout",
			"type": "XML",
			"async": true
		},
		"dependencies": {
			"libs": {
				"sap.f": {},
				"sap.ui.core": {}
			}
		},
		"config": {
			"sample": {
				"stretch": true,
				"files": [
					"Component.js",
					"controller/FlexibleColumnLayout.controller.js",
					"view/FlexibleColumnLayout.view.xml",
					"controller/List.controller.js",
					"view/List.view.xml",
					"controller/Detail.controller.js",
					"controller/DetailDetail.controller.js",
					"view/Detail.view.xml",
					"view/DetailDetail.view.xml",
					"manifest.json"
				]
			}
		}
	}
}