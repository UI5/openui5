{
	"sap.app": {
		"id": "sap.f.sample.AvatarGroup",
		"applicationVersion": {
			"version": "1.0.0"
		},
		"title": "Avatar Group",
		"description": "Two data-bound AvatarGroups side by side - Individual mode opens a single-avatar detail popover, Group mode opens a list popover with NavContainer drill-down; a Slider controls container width to demonstrate overflow behavior.",
		"tags": {
			"keywords": [
				"sap.f.AvatarGroup",
				"individual-mode",
				"group-mode",
				"data-binding",
				"popover",
				"overflow"
			]
		},
		"complexity": "intermediate"
	},
	"sap.ui5": {
		"rootView": {
			"viewName": "sap.f.sample.AvatarGroup.view.AvatarGroup",
			"type": "XML",
			"async": true
		},
		"dependencies": {
			"libs": {
				"sap.f": {},
				"sap.m": {},
				"sap.ui.core": {},
				"sap.ui.layout": {}
			}
		},
		"config": {
			"sample": {
				"stretch": true,
				"files": [
					"view/AvatarGroup.view.xml",
					"view/Card.fragment.xml",
					"view/GroupPopover.fragment.xml",
					"view/IndividualPopover.fragment.xml",
					"controller/AvatarGroup.controller.js",
					"model/avatargroup.json",
					"manifest.json"
				]
			}
		}
	}
}