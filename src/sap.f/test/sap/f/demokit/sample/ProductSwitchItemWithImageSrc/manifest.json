			"keywords": [
				"sap.f.ProductSwitch",
				"sap.f.ProductSwitchItem",
				"image-src",
				"product-switch-item",
				"url-helper"
			]
		},
		"complexity": "basic"
	},
	"sap.ui5": {
		"rootView": {
			"viewName": "sap.f.sample.ProductSwitchItemWithImageSrc.view.ProductSwitchItemWithImageSrc",
			"type": "XML",
			"async": true
		},
		"dependencies": {
			"libs": {
				"sap.f": {},
				"sap.m": {},
				"sap.ui.core": {},
				"sap.ui.layout": {}
			}
		},
		"config": {
			"sample": {
				"stretch": true,
				"files": [
					"view/ProductSwitchItemWithImageSrc.fragment.xml",
					"view/ProductSwitchItemWithImageSrc.view.xml",
					"controller/ProductSwitchItemWithImageSrc.controller.js",
					"manifest.json"
				]
			}
		}
	}
}