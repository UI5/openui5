{
	"sap.app": {
		"id": "sap.f.sample.ShellBarWithFlexibleColumnLayout",
		"applicationVersion": {
			"version": "1.0.0"
		},
		"title": "Shell Bar with Flexible Column Layout",
		"description": "A sap.f.ShellBar used as the custom header above a routing-based FlexibleColumnLayout, wiring the ShellBar back navigation to the fullscreen (EndColumnFullScreen) layout state, with search, notifications, menu and avatar in the ShellBar.",
		"tags": {
			"keywords": [
				"sap.f.ShellBar",
				"sap.f.FlexibleColumnLayout",
				"shell-bar",
				"routing",
				"semantic-helper",
				"fullscreen",
				"navigation"
			]
		},
		"complexity": "advanced"
	},
	"sap.ui5": {
		"config": {
			"sample": {
				"iframe": "webapp/index.html",
				"stretch": true,
				"files": [
					"webapp/view/Detail.view.xml",
					"webapp/view/DetailDetail.view.xml",
					"webapp/view/FlexibleColumnLayout.view.xml",
					"webapp/view/List.view.xml",
					"webapp/view/AboutPage.view.xml",
					"webapp/controller/Detail.controller.js",
					"webapp/controller/DetailDetail.controller.js",
					"webapp/controller/FlexibleColumnLayout.controller.js",
					"webapp/controller/List.controller.js",
					"webapp/controller/AboutPage.controller.js",
					"webapp/Component.js",
					"webapp/index.html",
					"webapp/index.js",
					"webapp/manifest.json",
					"ui5.yaml",
					"package.json"
				]
			}
		}
	}
}