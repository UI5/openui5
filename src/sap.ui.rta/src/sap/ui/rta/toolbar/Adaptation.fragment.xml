<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core">
	<Button
		id="sapUiRta_actionsMenu"
		icon="sap-icon://overflow"
		enabled="{controls>/adaptationMode}"
		type="Transparent"
		tooltip="{i18n>BTN_MENU}"
		press=".showActionsMenu"
		ariaHasPopup="Menu" >
		<layoutData>
			<OverflowToolbarLayoutData priority="NeverOverflow"/>
		</layoutData>
	</Button>
	<Button
		id="sapUiRta_backButton"
		icon="sap-icon://nav-back"
		type="Transparent"
		enabled="{controls>/backButton/enabled}"
		visible="{controls>/backButton/visible}"
		tooltip="{i18n>BTN_BACK}"
		class="sapUiTinyMarginEnd"
		press=".navigateBack" >
		<layoutData>
			<OverflowToolbarLayoutData priority="NeverOverflow"/>
		</layoutData>
	</Button>
	<HBox id="sapUiRta_iconBox" class="sapUiTinyMarginBeginEnd" />
	<Label text="{controls>/appName}" design="Bold" class="sapUiRtaToolbarAppName sapUiRtaToolbarText">
		<layoutData>
			<OverflowToolbarLayoutData priority="Disappear"/>
		</layoutData>
	</Label>
	<MenuButton
		id="sapUiRta_versionButton"
		class="sapUiRtaVersionButton"
		visible="{= (${versions>/versioningEnabled} &amp;&amp; ${controls>/adaptationMode} &amp;&amp; ${controls>/changesNeedHardReload} === false)}"
		text="{parts: [{path: 'versions>/versions'}, {path: 'versions>/displayedVersion'}], formatter: '.formatVersionButtonText'}"
		menuPosition="BeginBottom">
		<Menu class="sapUiRTABorder">
			<MenuItem
				id="sapUiRta_discardDraft"
				text="{i18n>TOL_DISCARD_DRAFT}"
				icon="sap-icon://delete"
				visible="{parts: ['versions>/displayedVersion', 'versions>/versioningEnabled', 'controls>/adaptationMode'], formatter: '.formatDiscardDraftVisible'}"
				tooltip="{i18n>TOL_DISCARD_DRAFT}"
				press=".discardDraft" />
			<MenuItem
				id="sapUiRta_activate"
				icon="sap-icon://activate"
				press=".activate"
				visible="{= (${versions>/versioningEnabled} &amp;&amp; ${controls>/adaptationMode})}"
				enabled="{versions>/activateEnabled}"
				text="{i18n>TOL_ACTIVATE}"
				tooltip="{i18n>TOL_ACTIVATE}" />
			<MenuItem
				id="sapUiRta_publishVersion"
				enabled="{parts: ['versions>/publishVersionVisible', 'versions>/displayedVersion'], formatter: '.formatPublishVersionEnabled'}"
				visible="{= (${versions>/versioningEnabled} &amp;&amp; ${controls>/adaptationMode} &amp;&amp; ${versions>/publishVersionVisible})}"
				press=".publishVersion"
				icon="sap-icon://shipping-status"
				text="{i18n>TOL_PUBLISH_VERSION}"
				tooltip="{i18n>TOL_PUBLISH_VERSION}" />
			<MenuItem
				id="sapUiRta_showManageVersions"
				press=".showManageVersions"
				enabled="{= ${versions>/versions}.length > 0}"
				icon="sap-icon://dimension"
				text="{i18n>TIT_MANAGE_VERSIONS}"
				tooltip="{i18n>TIT_MANAGE_VERSIONS}" />
		</Menu>
	</MenuButton>
	<Button
		id="sapUiRta_hardReloadButton"
		type="Attention"
		visible="{= ${controls>/changesNeedHardReload} === true}"
		text="{i18n>SAVE_AND_RELOAD}"
		iconFirst="true"
		icon="sap-icon://refresh"
		press=".saveAndReloadApp">
		<layoutData>
			<OverflowToolbarLayoutData priority="Low"/>
		</layoutData>
	</Button>
	<Button
		id="sapUiRta_hardReloadInfoButton"
		type="Attention"
		visible="{= ${controls>/changesNeedHardReload} === true}"
		press=".showHardReloadInfoPopover"
		icon="sap-icon://question-mark"
		class="sapUiNoMarginBeginEnd sapUiRtaHardReloadInfoButton"
		tooltip="{i18n>TOL_SHOW_HARD_RELOAD_INFO}">
		<layoutData>
			<OverflowToolbarLayoutData priority="Low"/>
		</layoutData>
	</Button>
	<OverflowToolbarButton
		id="sapUiRta_save"
		type="Transparent"
		press=".save"
		enabled="{controls>/save/enabled}"
		visible="{parts: ['versions>/versioningEnabled', 'versions>/displayedVersion', 'controls>/adaptationMode'], formatter: '.formatSaveVisibility'}"
		text="{= ${versions>/versioningEnabled} ? ${i18n>BTN_SAVE_DRAFT} : ${i18n>BTN_SAVE} }"
		tooltip="{= ${versions>/versioningEnabled} ? ${i18n>BTN_SAVE_DRAFT} : ${i18n>BTN_SAVE} }"
		icon="sap-icon://save">
		<layoutData>
			<OverflowToolbarLayoutData priority="High"/>
		</layoutData>
	</OverflowToolbarButton>
	<ToolbarSeparator visible="{controls>/adaptationMode}"/>
	<OverflowToolbarButton
		id="sapUiRta_undo"
		icon="sap-icon://undo"
		press=".undo"
		enabled="{controls>/undo/enabled}"
		visible="{controls>/adaptationMode}"
		type="Transparent"
		text="{i18n>BTN_UNDO}"
		tooltip="{i18n>BTN_UNDO}">
		<layoutData>
			<OverflowToolbarLayoutData priority="High" group="1" />
		</layoutData>
	</OverflowToolbarButton>
	<OverflowToolbarButton
		id="sapUiRta_redo"
		icon="sap-icon://redo"
		press=".redo"
		enabled="{controls>/redo/enabled}"
		visible="{controls>/adaptationMode}"
		type="Transparent"
		text="{i18n>BTN_REDO}"
		tooltip="{i18n>BTN_REDO}">
		<layoutData>
			<OverflowToolbarLayoutData priority="High" group="1" />
		</layoutData>
	</OverflowToolbarButton>
	<ToolbarSpacer />
	<Label text="{i18n>ADAPTATION_MODE}" labelFor="sapUiRta_modeSwitcher" class="sapUiRtaToolbarText">
		<layoutData>
			<OverflowToolbarLayoutData priority="Disappear"/>
		</layoutData>
	</Label>
	<Switch
		id="sapUiRta_modeSwitcher"
		state="{controls>/adaptationMode}"
		tooltip="{i18n>ADAPTATION_MODE}"
		change=".modeChange"
		customTextOff=" "
		customTextOn=" ">
		<layoutData>
			<OverflowToolbarLayoutData priority="High"/>
		</layoutData>
	</Switch>
	<OverflowToolbarButton
		id="sapUiRta_exit"
		type="Transparent"
		press=".exit"
		tooltip="{i18n>BTN_EXIT}"
		icon="sap-icon://decline">
		<layoutData>
			<OverflowToolbarLayoutData priority="NeverOverflow"/>
		</layoutData>
	</OverflowToolbarButton>
</core:FragmentDefinition>
