<core:FragmentDefinition
	xmlns:core="sap.ui.core"
	xmlns="sap.m">
	<Dialog id="manageVersionsDialog" class="sapUiRTABorder sapUiRtaManageVersionsDialog" contentWidth="60%">
		<customHeader>
			<Toolbar>
				<Title level="H1" text="{i18n>TIT_MANAGE_VERSIONS}" />
				<ToolbarSpacer />
				<Button
					id="closeManageVersionsDialogButton"
					icon="sap-icon://decline"
					tooltip="{i18n>BTN_CLOSE_FEEDBACK_DIALOG}"
					press=".closeManageVersionsDialog" />
			</Toolbar>
		</customHeader>
		<content>
			<Table
				id="versionList"
				growing="true"
				growingThreshold="20"
				growingScrollToLoad="true"
				keyboardMode="Edit"
				fixedLayout="false"
				sticky="ColumnHeaders"
				class="sapUiRtaVersionsList"
				noDataText="{i18n>NO_ADDITIONAL_VERSIONS_AVAILABLE}"
				updateFinished=".applyDraftVersionClasses"
				items="{versions>/versions}" >
				<columns>
					<Column width="40%">
						<Text text="{i18n>TIT_VERSION_COLUMN}" />
					</Column>
					<Column width="10%">
					</Column>
					<Column width="20%">
						<Text text="{i18n>TIT_CHANGEVISUALIZATION_DATE}" />
					</Column>
					<Column width="24%">
						<Text text="{i18n>TIT_CHANGEVISUALIZATION_USER}" />
					</Column>
					<Column width="6%" />
				</columns>
				<items>
					<ColumnListItem>
						<Text text="{parts: [{path: 'versions>title'}, {path: 'versions>type'}], formatter: '.formatVersionTitle'}" />
						<ObjectStatus
							text="{parts: ['versions>type', 'versions>isPublished'], formatter: '.formatVersionStateText'}"
							icon="{parts: ['versions>type', 'versions>isPublished'], formatter: '.formatVersionIcon'}"
							state="{parts: ['versions>type', 'versions>isPublished'], formatter: '.formatVersionState'}" />
						<Text text="{parts: ['versions>activatedAt', 'versions>importedAt'], formatter: '.formatVersionTimeStamp'}" />
						<Text text="{versions>activatedBy}" />
						<Button
							enabled="{= ${versions>/displayedVersion} !== ${versions>version}}"
							type="Transparent"
							icon="sap-icon://navigation-right-arrow"
							tooltip="{i18n>TOL_SWITCH_TO_VERSION}"
							press=".versionSelected" />
					</ColumnListItem>
				</items>
			</Table>
		</content>
		<footer>
			<Toolbar>
				<Table
					id="originalVersionList"
					keyboardMode="Edit"
					fixedLayout="false"
					showSeparators="None"
					class="sapUiRtaOriginalVersionList">
					<columns>
						<Column width="40%" />
						<Column width="10%" />
						<Column width="20%" />
						<Column width="24%" />
						<Column width="6%" />
					</columns>
					<items>
						<ColumnListItem
							id="sapUiRta_originalVersionItem"
							type="Inactive">
							<Text text="{i18n>TIT_ORIGINAL_APP}" />
							<Text text="" />
							<Text text="" />
							<Text text="" />
							<Button
								id="sapUiRta_originalVersionButton"
								type="Transparent"
								enabled="{parts: ['versions>/displayedVersion'], formatter: '.formatOriginalVersionButtonEnabled'}"
								icon="sap-icon://navigation-right-arrow"
								tooltip="{i18n>TIT_SWITCH_TO_ORIGINAL_APP}"
								press=".versionSelected" />
						</ColumnListItem>
					</items>
				</Table>
			</Toolbar>
		</footer>
	</Dialog>
</core:FragmentDefinition>