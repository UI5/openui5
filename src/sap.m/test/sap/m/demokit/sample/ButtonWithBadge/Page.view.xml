<mvc:View
	controllerName="sap.m.sample.ButtonWithBadge.Page"
	height="100%"
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:layout="sap.ui.layout">
	<Page title="Button with Badge">
		<content>
			<layout:VerticalLayout class="sapUiContentPadding" width="100%">
				<Toolbar>
					<content>
						<Title text="Buttons"/>
					</content>
				</Toolbar>
				<Label class="sapUiTinyMarginBeginEnd sapUiTinyMarginTop" text="Default (Counter) BadgeStyle"/>
				<FlexBox class="sapUiTinyMarginBeginEnd sapUiTinyMarginTop" wrap="Wrap">
					<Button
						id="DefaultIconButton"
						class="sapUiTinyMarginEnd"
						icon="sap-icon://cart"
						type="{/buttonType}"
						badgeStyle="Default">
						<customData>
							<BadgeCustomData key="badge" value="5" visible="true"/>
						</customData>
					</Button>
					<Button
						id="DefaultTextButton"
						class="sapUiTinyMarginEnd"
						text="Button with Badge"
						type="{/buttonType}"
						badgeStyle="Default">
						<customData>
							<BadgeCustomData key="badge" value="5" visible="true"/>
						</customData>
					</Button>
				</FlexBox>
				<Label class="sapUiTinyMarginBeginEnd sapUiTinyMarginTop" text="Attention BadgeStyle"/>
				<FlexBox class="sapUiTinyMarginBeginEnd sapUiTinyMarginTop" wrap="Wrap">
					<Button
						id="AttentionIconButton"
						class="sapUiTinyMarginEnd"
						icon="sap-icon://cart"
						type="{/buttonType}"
						badgeStyle="Attention">
						<customData>
							<BadgeCustomData key="badge" value="5" visible="true"/>
						</customData>
					</Button>
					<Button
						id="AttentionTextButton"
						class="sapUiTinyMarginEnd"
						text="Button with Badge"
						type="{/buttonType}"
						badgeStyle="Attention">
						<customData>
							<BadgeCustomData key="badge" value="5" visible="true"/>
						</customData>
					</Button>
				</FlexBox>
				<Toolbar class="sapUiSmallMarginTop">
					<content>
						<Title text="Badge min, max and current values"/>
					</content>
				</Toolbar>
				<FlexBox
					class="sapUiTinyMarginBeginEnd"
					alignItems="Center"
					justifyContent="Start">
					<Text
						renderWhitespace="true"
						width="150px"
						text="Current badge value is "/>
					<StepInput
						id="CurrentValue"
						value="{/badgeCurrent}"
						width="130px"
						change=".currentChangeHandler"/>
				</FlexBox>
				<FlexBox
					class="sapUiTinyMarginBeginEnd"
					alignItems="Center"
					justifyContent="Start">
					<Text
						renderWhitespace="true"
						width="150px"
						text="Limit badge value from "/>
					<Input
						id="MinInput"
						value="{/badgeMin}"
						width="55px"
						type="Number"
						change=".minChangeHandler"/>
					<Text
						renderWhitespace="true"
						text=" to "/>
					<Input
						id="MaxInput"
						value="{/badgeMax}"
						width="55px"
						type="Number"
						change=".maxChangeHandler"/>
				</FlexBox>
				<Text
					class="sapUiTinyMarginBeginEnd"
					renderWhitespace="true"
					text="(fill something in 'from' and/or 'to' fields to test)"/>
				<Toolbar class="sapUiSmallMarginTop">
					<content>
						<Title text="Button properties"/>
					</content>
				</Toolbar>
				<MessageStrip
					class="sapUiSmallMarginTop sapUiTinyMarginBeginEnd"
					enableFormattedText="true"
					text="Although badges can technically be displayed on the &lt;strong&gt;Accept&lt;/strong&gt;, &lt;strong&gt;Reject&lt;/strong&gt;, and &lt;strong&gt;Attention&lt;/strong&gt; button variants, this is not recommended. These variants already communicate a specific action through their color, making it unclear whether a numeric badge refers to the action&apos;s outcome or an associated item count. Badges are intended only for the &lt;strong&gt;Default&lt;/strong&gt; and &lt;strong&gt;Icon-only&lt;/strong&gt; buttons to display notification counts or the number of related items (for example, unread messages or selected items)."
					type="Warning"
					showIcon="true"/>
				<FlexBox
					class="sapUiTinyMarginBeginEnd"
					alignItems="Center"
					justifyContent="Start">
					<Text
						renderWhitespace="true"
						width="39px"
						text="Type  "/>
					<Select
						id="ButtonType"
						selectedKey="{/buttonType}">
						<core:Item
								key="Default"
								text="Default"/>
						<core:Item
								key="Transparent"
								text="Transparent"/>
						<core:Item
								key="Emphasized"
								text="Emphasized"/>
					</Select>
				</FlexBox>
				<Toolbar class="sapUiSmallMarginTop">
					<content>
						<Title text="Notes"/>
					</content>
				</Toolbar>
				<Text
					class="sapUiTinyMargin"
					wrapping="true"
					text="1. The value displayed in the Badge is controlled by the Button - if the value is below 1, the badge is hidden; if value is above the 9999, it is displayed as 999+"/>
				<Text
					class="sapUiTinyMargin"
					wrapping="true"
					text="2. If an application developer wants to control more precisely the value and appearance of the Badge, that can be done as it is presented in this sample, but the constraints mentioned in (1) cannot be exceeded!"/>
			</layout:VerticalLayout>
		</content>
	</Page>
</mvc:View>