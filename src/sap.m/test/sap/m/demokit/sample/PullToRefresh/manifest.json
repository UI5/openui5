{
	"sap.app": {
		"id": "sap.m.sample.PullToRefresh",
		"applicationVersion": {
			"version": "1.0.0"
		},
		"title": "Pull To Refresh",
		"description": "Minimal PullToRefresh pattern: the refresh event handler simulates a 1-second async load then calls hide() to collapse the pull indicator. A List shows incrementally loaded product items.",
		"tags": { "keywords": ["sap.m.PullToRefresh", "refresh-event", "hide", "data-loading", "list"] },
		"complexity": "basic"
	},
	"sap.ui5": {
		"rootView": {
			"viewName": "sap.m.sample.PullToRefresh.view.PullToRefresh",
			"type": "XML",
			"async": true
		},
		"dependencies": {
			"libs": {
				"sap.m": {},
				"sap.ui.core": {}
			}
		},
		"config": {
			"sample": {
				"stretch": true,
				"files": [
					"view/PullToRefresh.view.xml",
					"controller/PullToRefresh.controller.js",
					"manifest.json"
				]
			}
		}
	}
}