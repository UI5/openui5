{
	"sap.app": {
		"id": "sap.m.sample.SelectChangeEvents",
		"applicationVersion": {
			"version": "1.0.0"
		},
		"title": "Select - Change Events",
		"description": "A data-bound Select wired to the change and liveChange events, with handlers reading the selected and previously selected items and showing a MessageToast.",
		"tags": {
			"keywords": [
				"sap.m.Select",
				"change-event",
				"livechange-event",
				"events",
				"data-binding"
			]
		},
		"complexity": "basic"
	},
	"sap.ui5": {
		"rootView": {
			"viewName": "sap.m.sample.SelectChangeEvents.Page",
			"type": "XML",
			"async": true
		},
		"dependencies": {
			"libs": {
				"sap.m": {},
				"sap.ui.core": {}
			}
		},
		"config": {
			"sample": {
				"stretch": true,
				"files": [
					"Page.view.xml",
					"Page.controller.js",
					"manifest.json"
				]
			}
		}
	}
}