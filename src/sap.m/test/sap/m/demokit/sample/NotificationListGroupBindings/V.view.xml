<mvc:View
	controllerName="sap.m.sample.NotificationListGroupBindings.C"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.m"
	class="sapUiBodyBackground sapContrastPlus">
	<VBox class="sapUiSmallMargin">
		<MessageStrip
			enableFormattedText="true"
			text="Deprecated as of version 1.153. Use the UI5 Web Components' notifications instead, which are UXC-compliant and can be integrated using ui5-tooling-modules. See &lt;a href=&quot;https://ui5.sap.com/#/topic/1c80793df5bb424091954697fc0b2828&quot; target=&quot;_blank&quot;&gt;Using Web Components&lt;/a&gt; and the &lt;a href=&quot;https://github.com/SAP-samples/uxc-integration&quot; target=&quot;_blank&quot;&gt;UXC integration sample&lt;/a&gt;."
			type="Warning"
			showIcon="true"
			class="sapUiSmallMarginBottom" />
		<NotificationList items="{ path: '/NotificationGroups', templateShareable: true }">
			<layoutData>
				<FlexItemData maxWidth="600px" />
			</layoutData>

			<NotificationListGroup
				title="{title}"
				showCloseButton="{showCloseButton}"
				showEmptyGroup="{showEmptyGroup}"
				close=".onGroupClose"
				items="{
					path: 'groupItems',
					templateShareable: true
				}"
				buttons="{
					path: 'groupButtons',
					templateShareable: true
				}">
				<buttons>
					<Button text="{text}" press=".onGroupButtonPress" />
				</buttons>

				<NotificationListItem
					title="{title}"
					description="{description}"
					showCloseButton="{showCloseButton}"
					datetime="{creationDate}"
					unread="{unread}"
					priority="{
						path: 'priority',
						formatter: '.priorityFormatter'
					}"
					close=".onItemClose"
					press=".onListItemPress"
					authorPicture="{authorPicture}"
					authorInitials="{authorInitials}"
					authorAvatarColor="{authorAvatarColor}"
					buttons="{
						path: 'itemButtons',
						templateShareable: true
					}">
					<buttons>
						<Button text="{text}" press=".onItemButtonPress" />
					</buttons>
				</NotificationListItem>
			</NotificationListGroup>
		</NotificationList>
	</VBox>
</mvc:View>
