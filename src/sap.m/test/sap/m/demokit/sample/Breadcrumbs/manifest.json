{
	"sap.app": {
		"id": "sap.m.sample.Breadcrumbs",
		"applicationVersion": {
			"version": "1.0.0"
		},
		"title": "Breadcrumbs sample",
		"description": "Shows sap.m.Breadcrumbs with currentLocationText and multiple Link items, with a Select control that lets the user switch separatorStyle at runtime (Slash/BackSlash/DoubleSlash) via two-way binding.",
		"tags": {
			"keywords": ["sap.m.Breadcrumbs", "current-location-text", "separator-style", "links", "data-binding"]
		},
		"complexity": "intermediate"
	},
	"sap.ui5": {
		"rootView": {
			"viewName": "sap.m.sample.Breadcrumbs.view.Breadcrumbs",
			"type": "XML",
			"async": true
		},
		"dependencies": {
			"libs": {
				"sap.m": {},
				"sap.ui.core": {}
			}
		},
		"config": {
			"sample": {
				"files": [
					"view/Breadcrumbs.view.xml",
					"controller/Breadcrumbs.controller.js",
					"manifest.json"
				]
			}
		}
	}
}