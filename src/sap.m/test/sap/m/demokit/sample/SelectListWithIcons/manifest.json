{
	"sap.app": {
		"id": "sap.m.sample.SelectListWithIcons",
		"applicationVersion": {
			"version": "1.0.0"
		},
		"title": "SelectList - With Icons",
		"description": "SelectList where each item uses sap.ui.core.ListItem (instead of plain Item) to add an icon alongside the text. Demonstrates icon-enriched selection lists.",
		"tags": { "keywords": ["sap.m.SelectList", "list-item", "icon", "selection-change"] },
		"complexity": "basic"
	},
	"sap.ui5": {
		"rootView": {
			"viewName": "sap.m.sample.SelectListWithIcons.Page",
			"type": "XML",
			"async": true
		},
		"dependencies": {
			"libs": {
				"sap.m": {},
				"sap.ui.core": {}
			}
		},
		"config": {
			"sample": {
				"stretch": true,
				"files": [
					"Page.view.xml",
					"Page.controller.js",
					"manifest.json"
				]
			}
		}
	}
}