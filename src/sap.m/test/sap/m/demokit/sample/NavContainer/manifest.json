{
	"sap.app": {
		"id": "sap.m.sample.NavContainer",
		"applicationVersion": {
			"version": "1.0.0"
		},
		"title": "Nav Container",
		"description": "Four-page sap.m.NavContainer with forward/back navigation using CustomData key/value pairs for page identification. Shows the navigationFinished event and a Select for switching transition animations (slide, baseSlide, fade, flip, show) at runtime.",
		"tags": {
			"keywords": ["sap.m.NavContainer", "navigation", "custom-data", "navigation-finished", "transition-animation", "multi-page"]
		},
		"complexity": "intermediate"
	},
	"sap.ui5": {
		"rootView": {
			"viewName": "sap.m.sample.NavContainer.view.NavContainer",
			"type": "XML",
			"async": true
		},
		"dependencies": {
			"libs": {
				"sap.m": {},
				"sap.ui.core": {},
				"sap.ui.layout": {}
			}
		},
		"resources": {
			"css": [
				{
					"uri": "style.css"
				}
			]
		},
		"config": {
			"sample": {
				"stretch": true,
				"files": [
					"view/NavContainer.view.xml",
					"controller/NavContainer.controller.js",
					"style.css",
					"manifest.json"
				]
			}
		}
	}
}