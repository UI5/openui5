{
	"sap.app": {
		"id": "sap.m.sample.Select",
		"applicationVersion": {
			"version": "1.0.0"
		},
		"title": "Select",
		"description": "Three data-bound Selects placed in a page header, content and footer, demonstrating default, enabled/editable-toggled, and IconOnly display options with two-way selectedKey binding.",
		"tags": {
			"keywords": [
				"sap.m.Select",
				"data-binding",
				"selected-key",
				"icon-only",
				"editable",
				"toolbar"
			]
		},
		"complexity": "intermediate"
	},
	"sap.ui5": {
		"rootView": {
			"viewName": "sap.m.sample.Select.Page",
			"type": "XML",
			"async": true
		},
		"dependencies": {
			"libs": {
				"sap.m": {},
				"sap.ui.core": {},
				"sap.ui.layout": {}
			}
		},
		"config": {
			"sample": {
				"stretch": true,
				"files": [
					"Page.view.xml",
					"Page.controller.js",
					"manifest.json"
				]
			}
		}
	}
}