{
	"sap.app": {
		"id": "sap.m.sample.Image",
		"applicationVersion": {
			"version": "1.0.0"
		},
		"title": "Image",
		"description": "Shows sap.m.Image in four variants: standard src binding, active state (decorative=false with press handler and ariaDetails link), SVG file, and inline SVG via mode=InlineSvg. Covers the most common Image use cases in a single view.",
		"tags": {
			"keywords": ["sap.m.Image", "src-binding", "active-state", "svg", "inline-svg", "mode", "decorative", "press", "aria-details"]
		},
		"complexity": "basic"
	},
	"sap.ui5": {
		"rootView": {
			"viewName": "sap.m.sample.Image.view.ImageGroup",
			"type": "XML",
			"async": true
		},
		"dependencies": {
			"libs": {
				"sap.m": {},
				"sap.ui.core": {},
				"sap.ui.layout": {}
			}
		},
		"config": {
			"sample": {
				"files": [
					"view/ImageGroup.view.xml",
					"controller/ImageGroup.controller.js",
					"images/sap-logo.svg",
					"manifest.json"
				]
			}
		}
	}
}