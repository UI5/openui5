{
	"sap.app": {
		"id": "sap.m.sample.Avatar",
		"applicationVersion": {
			"version": "1.0.0"
		},
		"title": "Avatar",
		"description": "Comprehensive showcase of sap.m.Avatar: image/icon/initials content types, all five predefined sizes (XS-XL) plus customDisplaySize, circle and square displayShape, Accent1-10 and special backgroundColor values (Transparent, TileIcon, Placeholder, Random), showBorder, fallbackIcon, enabled=false, and press event handling.",
		"tags": {
			"keywords": ["sap.m.Avatar", "display-size", "display-shape", "background-color", "initials", "icon", "image", "show-border", "fallback-icon", "press"]
		},
		"complexity": "intermediate"
	},
	"sap.ui5": {
		"rootView": {
			"viewName": "sap.m.sample.Avatar.view.Avatar",
			"type": "XML",
			"async": true
		},
		"resourceRoots": {
			"sap.m.images": "../../../images"
		},
		"dependencies": {
			"libs": {
				"sap.m": {},
				"sap.ui.core": {}
			}
		},
		"config": {
			"sample": {
				"stretch": true,
				"files": [
					"view/Avatar.view.xml",
					"controller/Avatar.controller.js",
					"manifest.json",
					"../../../images/Speakers_avatar_01.jpg",
					"../../../images/Woman_avatar_01.png",
					"../../../images/Woman_avatar_02.png",
					"../../../images/Screw_avatar_01.jpg",
					"../../../images/Lamp_avatar_01.jpg"
				]
			}
		}
	}
}