{
	"sap.app": {
		"id": "sap.m.sample.SelectValueState",
		"applicationVersion": {
			"version": "1.0.0"
		},
		"title": "Select - Validation states",
		"description": "Four data-bound Selects, each demonstrating one valueState - Error, Warning, Success and Information - together with valueStateText and associated labels.",
		"tags": {
			"keywords": [
				"sap.m.Select",
				"value-state",
				"validation",
				"value-state-text",
				"error",
				"warning",
				"success",
				"information"
			]
		},
		"complexity": "intermediate"
	},
	"sap.ui5": {
		"rootView": {
			"viewName": "sap.m.sample.SelectValueState.Page",
			"type": "XML",
			"async": true
		},
		"dependencies": {
			"libs": {
				"sap.m": {},
				"sap.ui.core": {},
				"sap.ui.layout": {}
			}
		},
		"config": {
			"sample": {
				"stretch": true,
				"files": [
					"Page.view.xml",
					"Page.controller.js",
					"manifest.json"
				]
			}
		}
	}
}