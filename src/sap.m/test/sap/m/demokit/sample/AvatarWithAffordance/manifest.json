{
	"sap.app": {
		"id": "sap.m.sample.AvatarWithAffordance",
		"applicationVersion": {
			"version": "1.0.0"
		},
		"title": "Avatar with Visual Affordance",
		"description": "Shows sap.m.Avatar badgeIcon and badgeTooltip for visual affordance (camera, edit, add actions), imageFitType=Cover, and the detailBox aggregation with a LightBox for full-screen image preview. All variants: custom badge icon with custom tooltip, custom badge icon with default tooltip, and default badge affordance.",
		"tags": {
			"keywords": ["sap.m.Avatar", "badge-icon", "badge-tooltip", "visual-affordance", "light-box", "image-fit-type", "detail-box"]
		},
		"complexity": "intermediate"
	},
	"sap.ui5": {
		"rootView": {
			"viewName": "sap.m.sample.AvatarWithAffordance.view.AvatarWithAffordance",
			"type": "XML",
			"async": true
		},
		"resourceRoots": {
			"sap.m.images": "../../../images"
		},
		"dependencies": {
			"libs": {
				"sap.m": {},
				"sap.ui.core": {}
			}
		},
		"config": {
			"sample": {
				"stretch": true,
				"files": [
					"view/AvatarWithAffordance.view.xml",
					"controller/AvatarWithAffordance.controller.js",
					"manifest.json",
					"../../../images/284133_GettyImages-145058106_2600.jpg",
					"../../../images/283930_shutterstock_56287057.jpg",
					"../../../images/282627_low_shutterstock_402830878.jpg",
					"../../../images/274827_274827_l_srgb_s_gl.jpg"
				]
			}
		}
	}
}