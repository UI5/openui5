{
	"sap.app": {
		"id": "sap.uxap.sample.ObjectPageBlockBase",
		"applicationVersion": {
			"version": "1.0.0"
		},
		"title": "ObjectPage Blockbase",
		"description": "An ObjectPage with multiple subsections demonstrating BlockBase columnLayout values (auto, 1, 2, 3), showSubSectionMore on a block, and a ConfigModel-driven subSectionLayout toggle via the header action.",
		"tags": {
			"keywords": ["sap.uxap.BlockBase", "sap.uxap.ObjectPageLayout", "column-layout", "subsection-layout", "show-subsection-more"]
		},
		"complexity": "intermediate"
	},
	"sap.ui5": {
		"rootView": {
			"viewName": "sap.uxap.sample.ObjectPageBlockBase.view.ObjectPageBlockBase",
			"type": "XML",
			"async": true
		},
		"resourceRoots": {
			"sap.uxap.sample.SharedBlocks": "../SharedBlocks"
		},
		"dependencies": {
			"libs": {
				"sap.m": {},
				"sap.ui.core": {},
				"sap.uxap": {}
			}
		},
		"config": {
			"sample": {
				"stretch": true,
				"files": [
					"view/ObjectPageBlockBase.view.xml",
					"controller/ObjectPageBlockBase.controller.js",
					"../SharedBlocks/BlockBlue.js",
					"../SharedBlocks/BlockBlue.view.xml",
					"../SharedBlocks/BlockBlueCtrl.controller.js",
					"../SharedBlocks/BlockBlueWithInfo.js",
					"../SharedBlocks/BlockBlueWithInfo.view.xml",
					"../SharedBlocks/BlockBlueWithInfoController.controller.js",
					"manifest.json"
				]
			}
		}
	}
}