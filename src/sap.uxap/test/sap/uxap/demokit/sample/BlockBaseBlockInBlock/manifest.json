{
	"sap.app": {
		"id": "sap.uxap.sample.BlockBaseBlockInBlock",
		"applicationVersion": {
			"version": "1.0.0"
		},
		"title": "Block in a block",
		"description": "A custom BlockBase that embeds another block inside it, with a ModelMapping passing a scoped JSON model path from the outer block context to the inner block's internalModelName.",
		"tags": {
			"keywords": ["sap.uxap.BlockBase", "sap.uxap.ModelMapping", "nested-block", "block-in-block", "model-mapping"]
		},
		"complexity": "intermediate"
	},
	"sap.ui5": {
		"rootView": {
			"viewName": "sap.uxap.sample.BlockBaseBlockInBlock.view.BlockBaseBlockInBlock",
			"type": "XML",
			"async": true
		},
		"dependencies": {
			"libs": {
				"sap.m": {},
				"sap.ui.core": {},
				"sap.uxap": {}
			}
		},
		"config": {
			"sample": {
				"stretch": true,
				"files": [
					"view/BlockBaseBlockInBlock.view.xml",
					"controller/blocks/Block.js",
					"view/blocks/Block.view.xml",
					"controller/blocks/InnerBlock.js",
					"view/blocks/InnerBlock.view.xml",
					"manifest.json"
				]
			}
		}
	}
}