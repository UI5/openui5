{
	"sap.app": {
		"id": "sap.uxap.sample.AnchorBar",
		"applicationVersion": {
			"version": "1.0.0"
		},
		"title": "ObjectPageLayout: anchor bar",
		"description": "An ObjectPageLayout showing the automatically generated anchor bar built from sections and subsections; clicking an anchor scrolls the page to the corresponding section, demonstrating the default ObjectPage navigation mechanism.",
		"tags": {
			"keywords": ["sap.uxap.ObjectPageLayout", "anchor-bar", "section-navigation", "scroll-navigation"]
		},
		"complexity": "basic"
	},
	"sap.ui5": {
		"rootView": {
			"viewName": "sap.uxap.sample.AnchorBar.view.AnchorBar",
			"type": "XML",
			"async": true
		},
		"dependencies": {
			"libs": {
				"sap.m": {},
				"sap.ui.core": {},
				"sap.ui.layout": {},
				"sap.uxap": {}
			}
		},
		"config": {
			"sample": {
				"stretch": true,
				"files": [
					"view/AnchorBar.view.xml",
					"controller/blocks/myBlock.js",
					"view/blocks/myBlock.view.xml",
					"controller/blocks/mySimpleBlock.js",
					"view/blocks/mySimpleBlock.view.xml",
					"manifest.json"
				]
			}
		}
	}
}