{
	"sap.app": {
		"id": "sap.uxap.sample.ObjectPageSubSectionSized",
		"applicationVersion": {
			"version": "1.0.0"
		},
		"title": "ObjectPageSubSection: explicit column sizing",
		"description": "An ObjectPageSubSection with explicit columnLayout values (auto, 1, 2, 3, 4) on each block; toolbar buttons let the user toggle useTwoColumnsForLargeScreen and subSectionLayout (TitleOnTop/TitleOnLeft) at runtime to compare layout options.",
		"tags": {
			"keywords": ["sap.uxap.ObjectPageSubSection", "column-layout", "use-two-columns", "subsection-layout", "title-on-left"]
		},
		"complexity": "intermediate"
	},
	"sap.ui5": {
		"rootView": {
			"viewName": "sap.uxap.sample.ObjectPageSubSectionSized.view.ObjectPageSubSectionSized",
			"type": "XML",
			"async": true
		},
		"dependencies": {
			"libs": {
				"sap.m": {},
				"sap.ui.core": {},
				"sap.uxap": {}
			}
		},
		"config": {
			"sample": {
				"stretch": true,
				"files": [
					"view/ObjectPageSubSectionSized.view.xml",
					"controller/ObjectPageSubSectionSize.controller.js",
					"controller/blocks/InfoButton.js",
					"view/blocks/InfoButton.view.xml",
					"controller/blocks/InfoButtonController.controller.js",
					"manifest.json"
				]
			}
		}
	}
}