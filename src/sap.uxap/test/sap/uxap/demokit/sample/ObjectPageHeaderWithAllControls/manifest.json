{
	"sap.app": {
		"id": "sap.uxap.sample.ObjectPageHeaderWithAllControls",
		"applicationVersion": {
			"version": "1.0.0"
		},
		"title": "ObjectPageHeader with all controls",
		"description": "A showcase of all ObjectPageHeader properties: wrapping objectTitle and objectSubtitle, showTitleSelector, markFavorite/markLocked/markFlagged, circular objectImage, 6 action buttons (including binding-driven icon and text), breadcrumbs, and responsive headerContent items using ObjectPageHeaderLayoutData breakpoint visibility (visibleS/M/L/XL).",
		"tags": {
			"keywords": ["sap.uxap.ObjectPageHeader", "title-selector", "markers", "object-image", "header-layout-data", "breadcrumbs", "responsive-visibility", "action-buttons"]
		},
		"complexity": "advanced"
	},
	"sap.ui5": {
		"rootView": {
			"viewName": "sap.uxap.sample.ObjectPageHeaderWithAllControls.view.ObjectPageHeaderWithAllControls",
			"type": "XML",
			"async": true
		},
		"resourceRoots": {
			"sap.uxap.sample.SharedBlocks": "../SharedBlocks",
			"sap.uxap.sample.SharedJSONData": "../SharedJSONData"
		},
		"dependencies": {
			"libs": {
				"sap.m": {},
				"sap.ui.core": {},
				"sap.ui.layout": {},
				"sap.uxap": {}
			}
		},
		"config": {
			"sample": {
				"stretch": true,
				"files": [
					"view/ObjectPageHeaderWithAllControls.view.xml",
					"controller/ObjectPageHeaderWithAllControls.controller.js",
					"../SharedBlocks/goals/GoalsBlock.js",
					"../SharedBlocks/goals/GoalsBlock.view.xml",
					"../SharedBlocks/personal/BlockAdresses.js",
					"../SharedBlocks/personal/BlockAdresses.view.xml",
					"../SharedBlocks/personal/BlockMailing.js",
					"../SharedBlocks/personal/BlockMailing.view.xml",
					"../SharedBlocks/personal/BlockPhoneNumber.js",
					"../SharedBlocks/personal/BlockPhoneNumber.view.xml",
					"../SharedBlocks/personal/BlockSocial.js",
					"../SharedBlocks/personal/BlockSocial.view.xml",
					"../SharedBlocks/personal/PersonalBlockPart1.js",
					"../SharedBlocks/personal/PersonalBlockPart1.view.xml",
					"../SharedBlocks/personal/PersonalBlockPart2.js",
					"../SharedBlocks/personal/PersonalBlockPart2.view.xml",
					"../SharedJSONData/employee.json",
					"../SharedJSONData/products.json",
					"view/Popover.fragment.xml",
					"view/PopoverLock.fragment.xml",
					"manifest.json"
