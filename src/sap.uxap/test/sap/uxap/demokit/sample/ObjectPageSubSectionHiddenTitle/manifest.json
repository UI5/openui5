{
	"sap.app": {
		"id": "sap.uxap.sample.ObjectPageSubSectionHiddenTitle",
		"applicationVersion": {
			"version": "1.0.0"
		},
		"title": "ObjectPageSubSection: hidden title",
		"description": "An ObjectPageSection with showTitle=false that hides the section title row so its single subsection (containing a products Table) is promoted and rendered without a section heading; a preceding section shows two subsections with SimpleForms.",
		"tags": {
			"keywords": ["sap.uxap.ObjectPageSection", "sap.uxap.ObjectPageSubSection", "show-title", "hidden-title"]
		},
		"complexity": "basic"
	},
	"sap.ui5": {
		"rootView": {
			"viewName": "sap.uxap.sample.ObjectPageSubSectionHiddenTitle.view.ObjectPageSubSectionHiddenTitle",
			"type": "XML",
			"async": true
		},
		"dependencies": {
			"libs": {
				"sap.m": {},
				"sap.ui.core": {},
				"sap.ui.layout": {},
				"sap.uxap": {}
			}
		},
		"config": {
			"sample": {
				"stretch": true,
				"files": [
                    "controller/ObjectPageSubSectionHiddenTitle.controller.js",
					"view/ObjectPageSubSectionHiddenTitle.view.xml",
					"manifest.json"
				]
			}
		}
	}
}