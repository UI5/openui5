{
	"sap.app": {
		"id": "sap.uxap.sample.ObjectPageSubSectionMultiView",
		"applicationVersion": {
			"version": "1.0.0"
		},
		"title": "ObjectPageSubSection: multi-view block distribution",
		"description": "An ObjectPageSubSection whose blocks have multiple view types (expanded/collapsed); the subsection automatically distributes blocks into columns based on block count, demonstrating how column count adapts to the number of blocks without explicit columnLayout settings.",
		"tags": {
			"keywords": ["sap.uxap.ObjectPageSubSection", "block-distribution", "multi-view-block", "auto-columns"]
		},
		"complexity": "basic"
	},
	"sap.ui5": {
		"rootView": {
			"viewName": "sap.uxap.sample.ObjectPageSubSectionMultiView.view.ObjectPageSubSectionMultiView",
			"type": "XML",
			"async": true
		},
		"resourceRoots": {
			"sap.uxap.sample.ObjectPageSubSection": "../ObjectPageSubSection"
		},
		"dependencies": {
			"libs": {
				"sap.m": {},
				"sap.ui.core": {},
				"sap.ui.layout": {},
				"sap.uxap": {}
			}
		},
		"config": {
			"sample": {
				"stretch": true,
				"files": [
					"controller/blocks/BlockEmpty.js",
					"view/blocks/BlockEmpty.view.xml",
                    "controller/ObjectPageSubSectionMultiView.controller.js",
                    "view/ObjectPageSubSectionMultiView.view.xml",
                    "../ObjectPageSubSection/controller/MultiViewBlockCommon.controller.js",
					"manifest.json"
				]
			}
		}
	}
}