{
	"sap.app": {
		"id": "sap.uxap.sample.ObjectPageOnJSONWithLazyLoading",
		"applicationVersion": {
			"version": "1.0.0"
		},
		"title": "ObjectPageLayout: lazy loading",
		"description": "An ObjectPageLayout with enableLazyLoading=true and headerContentPinned=true, showing employment BlockBase blocks that are only instantiated when their section scrolls into view, improving initial render performance.",
		"tags": {
			"keywords": ["sap.uxap.ObjectPageLayout", "enable-lazy-loading", "header-content-pinned", "performance", "employment-blocks"]
		},
		"complexity": "intermediate"
	},
	"sap.ui5": {
		"rootView": {
			"viewName": "sap.uxap.sample.ObjectPageOnJSONWithLazyLoading.view.ObjectPageOnJSONWithLazyLoading",
			"type": "XML",
			"async": true
		},
		"resourceRoots": {
			"sap.uxap.sample.SharedBlocks": "../SharedBlocks",
			"sap.uxap.sample.SharedJSONData": "../SharedJSONData"
		},
		"dependencies": {
			"libs": {
				"sap.m": {},
				"sap.ui.core": {},
				"sap.uxap": {}
			}
		},
		"config": {
			"sample": {
				"stretch": true,
				"files": [
					"view/ObjectPageOnJSONWithLazyLoading.view.xml",
					"controller/ObjectPageOnJSONWithLazyLoading.controller.js",
					"../SharedBlocks/employment/EmploymentBlockJob.js",
					"../SharedBlocks/employment/EmploymentBlockJobCollapsed.view.xml",
					"../SharedBlocks/employment/EmploymentBlockJobExpanded.view.xml",
                    "../SharedJSONData/HRData.json",
					"manifest.json"
				]
			}
		}
	}
}