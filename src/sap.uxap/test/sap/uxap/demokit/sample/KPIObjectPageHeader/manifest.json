{
	"sap.app": {
		"id": "sap.uxap.sample.KPIObjectPageHeader",
		"applicationVersion": {
			"version": "1.0.0"
		},
		"title": "ObjectPageHeader: KPI header",
		"description": "An ObjectPageHeader for a product/material page where the headerContent area contains KPI ObjectNumber values and ObjectAttribute pairs, demonstrating the standard SAP Fiori object page with numeric key performance indicators in the header.",
		"tags": {
			"keywords": ["sap.uxap.ObjectPageHeader", "kpi", "object-number", "object-attribute", "header-content"]
		},
		"complexity": "basic"
	},
	"sap.ui5": {
		"rootView": {
			"viewName": "sap.uxap.sample.KPIObjectPageHeader.view.KPIObjectPageHeader",
			"type": "XML",
			"async": true
		},
		"resourceRoots": {
			"sap.uxap.sample.SharedBlocks": "../SharedBlocks",
			"sap.uxap.sample.SharedJSONData": "../SharedJSONData"
		},
		"dependencies": {
			"libs": {
				"sap.m": {},
				"sap.ui.core": {},
				"sap.ui.layout": {},
				"sap.uxap": {}
			}
		},
		"config": {
			"sample": {
				"stretch": true,
				"files": [
					"view/KPIObjectPageHeader.view.xml",
					"controller/KPIObjectPageHeader.controller.js",
					"../SharedBlocks/goals/GoalsBlock.js",
					"../SharedBlocks/goals/GoalsBlock.view.xml",
					"../SharedBlocks/personal/BlockAdresses.js",
					"../SharedBlocks/personal/BlockAdresses.view.xml",
					"../SharedBlocks/personal/BlockMailing.js",
					"../SharedBlocks/personal/BlockMailing.view.xml",
					"../SharedBlocks/personal/BlockPhoneNumber.js",
					"../SharedBlocks/personal/BlockPhoneNumber.view.xml",
					"../SharedBlocks/personal/BlockSocial.js",
					"../SharedBlocks/personal/BlockSocial.view.xml",
					"../SharedBlocks/personal/PersonalBlockPart1.js",
					"../SharedBlocks/personal/PersonalBlockPart1.view.xml",
					"../SharedBlocks/personal/PersonalBlockPart2.js",
					"../SharedBlocks/personal/PersonalBlockPart2.view.xml",
					"../SharedJSONData/employee.json",
					"manifest.json"
				]
			}
		}
	}
}