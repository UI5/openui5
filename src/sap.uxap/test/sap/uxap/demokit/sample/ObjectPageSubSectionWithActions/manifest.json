{
	"sap.app": {
		"id": "sap.uxap.sample.ObjectPageSubSectionWithActions",
		"applicationVersion": {
			"version": "1.0.0"
		},
		"title": "ObjectPageSubSection: actions aggregation",
		"description": "A side-by-side comparison of subsections with and without an actions aggregation; buttons placed in the actions aggregation appear in the subsection header title bar, while subsections without actions show no action area.",
		"tags": {
			"keywords": ["sap.uxap.ObjectPageSubSection", "actions", "subsection-header", "action-buttons"]
		},
		"complexity": "basic"
	},
	"sap.ui5": {
		"rootView": {
			"viewName": "sap.uxap.sample.ObjectPageSubSectionWithActions.view.ObjectPageSubSectionWithActions",
			"type": "XML",
			"async": true
		},
		"resourceRoots": {
			"sap.uxap.sample.SharedBlocks": "../SharedBlocks"
		},
		"dependencies": {
			"libs": {
				"sap.m": {},
				"sap.ui.core": {},
				"sap.uxap": {}
			}
		},
		"config": {
			"sample": {
				"stretch": true,
				"files": [
					"view/ObjectPageSubSectionWithActions.view.xml",
					"../SharedBlocks/BlockBlue.js",
					"../SharedBlocks/BlockBlue.view.xml",
					"../SharedBlocks/BlockBlueCtrl.controller.js",
					"manifest.json"
				]
			}
		}
	}
}