{
	"sap.app": {
		"id": "sap.uxap.sample.ObjectPageDynamicSideContentBtn",
		"applicationVersion": {
			"version": "1.0.0"
		},
		"title": "ObjectPageHeader: DynamicSideContent button",
		"description": "An ObjectPageLayout wrapped inside a DynamicSideContent layout; the ObjectPageHeader has a sideContentButton that toggles the side panel, and the DynamicSideContent breakpointChanged event handler updates the side content visibility class at each viewport breakpoint.",
		"tags": {
			"keywords": ["sap.uxap.ObjectPageHeader", "sap.ui.layout.DynamicSideContent", "side-content-button", "breakpoint-changed", "toggle-side-panel"]
		},
		"complexity": "advanced"
	},
	"sap.ui5": {
		"rootView": {
			"viewName": "sap.uxap.sample.ObjectPageDynamicSideContentBtn.view.ObjectPageDynamicSideContentBtn",
			"type": "XML",
			"async": true
		},
		"resourceRoots": {
			"sap.uxap.sample.SharedBlocks": "../SharedBlocks",
			"sap.uxap.sample.SharedJSONData": "../SharedJSONData"
		},
		"dependencies": {
			"libs": {
				"sap.m": {},
				"sap.ui.core": {},
				"sap.ui.layout": {},
				"sap.uxap": {}
			}
		},
		"resources": {
			"css": [
				{
					"uri": "style.css"
				}
			]
		},
		"config": {
			"sample": {
				"stretch": true,
				"files": [
					"view/ObjectPageDynamicSideContentBtn.view.xml",
					"controller/ObjectPageDynamicSideContentBtn.controller.js",
					"style.css",
					"../SharedJSONData/employee.json",
					"manifest.json"
				]
			}
		}
	}
}