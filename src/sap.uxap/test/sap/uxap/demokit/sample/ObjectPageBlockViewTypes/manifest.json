{
	"sap.app": {
		"id": "sap.uxap.sample.ObjectPageBlockViewTypes",
		"applicationVersion": {
			"version": "1.0.0"
		},
		"title": "ObjectPageLayout: block view types and accessible landmark info",
		"description": "An ObjectPageLayout containing blocks implemented with all four UI5 view types (XML, JS, JSON, HTML), each placed in its own section, plus an ObjectPageAccessibleLandmarkInfo that provides custom ARIA region labels for the header, footer, and each section area.",
		"tags": {
			"keywords": ["sap.uxap.ObjectPageLayout", "sap.uxap.ObjectPageAccessibleLandmarkInfo", "block-view-types", "aria-landmark", "xml-view", "js-view", "accessibility"]
		},
		"complexity": "advanced"
	},
	"sap.ui5": {
		"rootView": {
			"viewName": "sap.uxap.sample.ObjectPageBlockViewTypes.view.ObjectPageOnJSON",
			"type": "XML"
		},
		"resourceRoots": {
			"sap.uxap.sample.SharedBlocks": "../SharedBlocks"
		},
		"dependencies": {
			"libs": {
				"sap.m": {},
				"sap.ui.core": {},
				"sap.ui.layout": {},
				"sap.uxap": {}
			}
		},
		"config": {
			"sample": {
				"stretch": true,
				"files": [
					"view/ObjectPageOnJSON.view.xml",
					"controller/ObjectPageOnJSON.controller.js",
					"../SharedBlocks/goals/GoalsBlock.js",
					"../SharedBlocks/goals/GoalsBlockJS.js",
					"../SharedBlocks/goals/GoalsBlockJSON.js",
					"../SharedBlocks/goals/GoalsBlockHTML.js",
					"../SharedBlocks/goals/GoalsBlock.view.xml",
					"../SharedBlocks/goals/GoalsBlockView.js",
					"../SharedBlocks/goals/GoalsBlock.view.json",
					"../SharedBlocks/goals/GoalsBlock.view.html",
					"manifest.json"
				]
			}
		}
	}
}