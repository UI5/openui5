{
	"sap.app": {
		"id": "sap.uxap.sample.ObjectPageSubSectionBackground",
		"applicationVersion": {
			"version": "1.0.0"
		},
		"title": "ObjectPageSubSection: transparent background",
		"description": "An ObjectPageSubSection with the sapUxAPObjectPageSubSectionTransparentBackground CSS class applied, removing the default card-style background so subsection content merges visually with the page background.",
		"tags": {
			"keywords": ["sap.uxap.ObjectPageSubSection", "transparent-background", "css-class", "custom-styling"]
		},
		"complexity": "basic"
	},
	"sap.ui5": {
		"rootView": {
			"viewName": "sap.uxap.sample.ObjectPageSubSectionBackground.view.ObjectPageSubSectionBackground",
			"type": "XML",
			"async": true
		},
		"resourceRoots": {
			"sap.uxap.sample.SharedBlocks": "../SharedBlocks"
		},
		"dependencies": {
			"libs": {
				"sap.m": {},
				"sap.ui.core": {},
				"sap.uxap": {}
			}
		},
		"config": {
			"sample": {
				"stretch": true,
				"files": [
					"view/ObjectPageSubSectionBackground.view.xml",
					"../SharedBlocks/BlockBlue.js",
					"../SharedBlocks/BlockBlue.view.xml",
					"../SharedBlocks/BlockBlueCtrl.controller.js",
					"manifest.json"
				]
			}
		}
	}
}