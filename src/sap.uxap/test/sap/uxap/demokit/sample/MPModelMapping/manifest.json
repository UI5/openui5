{
	"sap.app": {
		"id": "sap.uxap.sample.MPModelMapping",
		"applicationVersion": {
			"version": "1.0.0"
		},
		"title": "Model Mapping",
		"description": "A BlockBase block using ModelMapping with a static externalPath (/Employee), mapping the page-level JSONModel into the block's internalModelName (Contact) so the block accesses data under its own model alias.",
		"tags": {
			"keywords": ["sap.uxap.ModelMapping", "sap.uxap.BlockBase", "internal-model", "external-model", "model-scope"]
		},
		"complexity": "basic"
	},
	"sap.ui5": {
		"rootView": {
			"viewName": "sap.uxap.sample.MPModelMapping.view.ModelMapping",
			"type": "XML",
			"async": true
		},
		"dependencies": {
			"libs": {
				"sap.m": {},
				"sap.ui.core": {},
				"sap.ui.layout": {},
				"sap.uxap": {}
			}
		},
		"config": {
			"sample": {
				"stretch": true,
				"files": [
					"view/ModelMapping.view.xml",
					"controller/ModelMapping.controller.js",
					"view/blocks/ModelMappingBlock.view.xml",
                    "controller/blocks/ModelMappingBlock.js",
                    "manifest.json"
				]
			}
		}
	}
}