{
	"sap.app": {
		"id": "sap.uxap.sample.ObjectPageFormFocusableInput",
		"applicationVersion": {
			"version": "1.0.0"
		},
		"title": "ObjectPageLayout: focusable inputs in form blocks",
		"description": "An ObjectPageLayout where blocks contain SimpleForm controls with sap.m.Input fields, verifying that anchor bar navigation scrolls to the correct section and that focusable inputs within blocks are keyboard-accessible after navigation.",
		"tags": {
			"keywords": ["sap.uxap.ObjectPageLayout", "focusable-input", "keyboard-accessibility", "simple-form", "form-blocks"]
		},
		"complexity": "intermediate"
	},
	"sap.ui5": {
		"rootView": {
			"viewName": "sap.uxap.sample.ObjectPageFormFocusableInput.view.ObjectPageFormFocusableInput",
			"type": "XML",
			"async": true
		},
		"resourceRoots": {
			"sap.uxap.sample.ObjectPageFormLayout": "../ObjectPageFormLayout"
		},
		"dependencies": {
			"libs": {
				"sap.m": {},
				"sap.ui.core": {},
				"sap.ui.layout": {},
				"sap.uxap": {}
			}
		},
		"config": {
			"sample": {
				"stretch": true,
				"files": [
					"view/ObjectPageFormFocusableInput.view.xml",
					"view/blocks/BlockBlue.view.xml",
					"../ObjectPageFormLayout/controller/blocks/BlockBlue.js",
					"../ObjectPageFormLayout/view/blocks/BlockBlue.view.xml",
					"controller/ObjectPageFormFocusableInput.controller.js",
					"manifest.json"
				]
			}
		}
	}
}