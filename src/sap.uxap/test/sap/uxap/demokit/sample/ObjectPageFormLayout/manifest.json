{
	"sap.app": {
		"id": "sap.uxap.sample.ObjectPageFormLayout",
		"applicationVersion": {
			"version": "1.0.0"
		},
		"title": "ObjectPageLayout: form-based layout",
		"description": "An ObjectPageLayout with enableLazyLoading=true and breadcrumbs in the DynamicHeaderTitle, where subsections contain form-based BlockBase blocks (PersonalFormBlock, BlockJobInfo) built with SimpleForm, showing the standard edit-form pattern in an object page.",
		"tags": {
			"keywords": ["sap.uxap.ObjectPageLayout", "form-layout", "simple-form", "lazy-loading", "breadcrumbs", "dynamic-header-title"]
		},
		"complexity": "intermediate"
	},
	"sap.ui5": {
		"rootView": {
			"viewName": "sap.uxap.sample.ObjectPageFormLayout.view.ObjectPageFormLayout",
			"type": "XML",
			"async": true
		},
		"resourceRoots": {
			"sap.uxap.sample.SharedBlocks": "../SharedBlocks",
			"sap.uxap.sample.SharedJSONData": "../SharedJSONData"
		},
		"dependencies": {
			"libs": {
				"sap.m": {},
				"sap.ui.core": {},
				"sap.ui.layout": {},
				"sap.uxap": {}
			}
		},
		"config": {
			"sample": {
				"stretch": true,
				"files": [
					"view/ObjectPageFormLayout.view.xml",
					"controller/ObjectPageFormLayout.controller.js",
					"controller/blocks/PersonalFormBlock.js",
					"view/blocks/PersonalFormBlock.view.xml",
					"controller/blocks/BlockBlue.js",
					"view/blocks/BlockBlue.view.xml",
					"controller/blocks/BlockJobInfo.js",
					"view/blocks/BlockJobInfo.view.xml",
                    "../SharedJSONData/HRData.json",
					"manifest.json"
				]
			}
		}
	}
}