{
	"sap.app": {
		"id": "sap.uxap.sample.ObjectPageLazyLoadingWithoutBlocks",
		"applicationVersion": {
			"version": "1.0.0"
		},
		"title": "ObjectPageLayout: lazy loading without blocks",
		"description": "An ObjectPageLayout with enableLazyLoading=true where subsections contain plain form controls (SimpleForm) directly rather than BlockBase blocks, demonstrating that lazy loading works without the block abstraction.",
		"tags": {
			"keywords": ["sap.uxap.ObjectPageLayout", "enable-lazy-loading", "no-blocks", "simple-form", "direct-content"]
		},
		"complexity": "intermediate"
	},
	"sap.ui5": {
		"rootView": {
			"viewName": "sap.uxap.sample.ObjectPageLazyLoadingWithoutBlocks.view.ObjectPageLazyLoadingWithoutBlocks",
			"type": "XML",
			"async": true
		},
		"dependencies": {
			"libs": {
				"sap.m": {},
				"sap.ui.core": {},
				"sap.ui.layout": {},
				"sap.uxap": {}
			}
		},
		"config": {
			"sample": {
				"stretch": true,
				"files": [
					"view/ObjectPageLazyLoadingWithoutBlocks.view.xml",
					"controller/ObjectPageLazyLoadingWithoutBlocks.controller.js",
					"manifest.json"
				]
			}
		}
	}
}