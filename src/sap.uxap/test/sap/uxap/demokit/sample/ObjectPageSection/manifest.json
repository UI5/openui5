{
	"sap.app": {
		"id": "sap.uxap.sample.ObjectPageSection",
		"applicationVersion": {
			"version": "1.0.0"
		},
		"title": "ObjectPageSection",
		"description": "Demonstrates ObjectPageSection rendering: a section with a single subsection inherits its title (title merging), while sections with multiple subsections render each subsection title independently; shows how section title visibility is driven by subsection count.",
		"tags": {
			"keywords": ["sap.uxap.ObjectPageSection", "title-merging", "single-subsection", "multi-subsection"]
		},
		"complexity": "basic"
	},
	"sap.ui5": {
		"rootView": {
			"viewName": "sap.uxap.sample.ObjectPageSection.view.ObjectPageSection",
			"type": "XML",
			"async": true
		},
		"resourceRoots": {
			"sap.uxap.sample.SharedBlocks": "../SharedBlocks"
		},
		"dependencies": {
			"libs": {
				"sap.m": {},
				"sap.ui.core": {},
				"sap.uxap": {}
			}
		},
		"config": {
			"sample": {
				"stretch": true,
				"files": [
					"view/ObjectPageSection.view.xml",
					"../SharedBlocks/BlockBlueT1.js",
					"../SharedBlocks/BlockBlueT1.view.xml",
					"../SharedBlocks/BlockBlueT2.js",
					"../SharedBlocks/BlockBlueT2.view.xml",
					"../SharedBlocks/BlockBlueT3.js",
					"../SharedBlocks/BlockBlueT3.view.xml",
					"../SharedBlocks/BlockBlueT4.js",
					"../SharedBlocks/BlockBlueT4.view.xml",
					"../SharedBlocks/BlockBlueT5.js",
					"../SharedBlocks/BlockBlueT5.view.xml",
					"manifest.json"
				]
			}
		}
	}
}